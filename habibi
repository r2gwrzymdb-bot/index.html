<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>For Ayat</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

<style>
* {margin:0; padding:0; box-sizing:border-box;}

body {
  font-family:'Playfair Display', serif;
  overflow:hidden;
  background:black;
  color:white;
}

/* BACKGROUND */
video {
  position:fixed;
  width:100%;
  height:100%;
  object-fit:cover;
  filter:brightness(0.35) contrast(1.1);
  z-index:-2;
}

.overlay {
  position:fixed;
  width:100%;
  height:100%;
  background:radial-gradient(circle, rgba(0,0,0,0.2), rgba(0,0,0,0.95));
  z-index:-1;
}

/* SCENES */
.scene {
  position:absolute;
  width:100%;
  height:100%;
  display:flex;
  justify-content:center;
  align-items:center;
  text-align:center;
  padding:40px;
  opacity:0;
  transform:scale(1.1);
  transition:1.5s ease;
}

.scene.active {
  opacity:1;
  transform:scale(1);
}

h1 {
  max-width:900px;
  font-size:22px;
  line-height:1.8;
}

/* BUTTONS */
.buttons {
  margin-top:25px;
  display:flex;
  gap:15px;
  justify-content:center;
  flex-wrap:wrap;
}

button {
  padding:12px 24px;
  border-radius:30px;
  border:none;
  cursor:pointer;
  font-size:16px;
  transition:0.3s;
  font-family:inherit;
}

.primary {
  background:#e50914;
  color:white;
  box-shadow:0 0 20px #e50914;
}

.secondary {
  background:rgba(255,255,255,0.15);
  color:white;
}

/* HEARTS */
.heart {
  position:absolute;
  animation:floatUp 3s linear forwards;
}

@keyframes floatUp {
  from {transform:translateY(0); opacity:1;}
  to {transform:translateY(-250px); opacity:0;}
}

/* SOFT TEXT */
.soft {
  font-size:20px;
  opacity:0.9;
}

</style>
</head>

<body>

<video autoplay loop muted>
  <source src="https://cdn.coverr.co/videos/coverr-a-couple-walking-on-the-beach-1667/1080p.mp4">
</video>

<div class="overlay"></div>

<!-- SCENE 1 INTRO -->
<div class="scene active" id="s1">
  <div>
    <h1>
      This isn’t just a website…<br>
      it’s something I made for you, Ayat.
    </h1>

    <div class="buttons">
      <button class="primary" onclick="go(2)">Start</button>
    </div>
  </div>
</div>

<!-- SCENE 2 EMOTIONAL OPTIONS -->
<div class="scene" id="s2">
  <div>
    <h1 class="soft">Before anything… what do you want to feel?</h1>

    <div class="buttons">
      <button class="primary" onclick="go(3)">💖 Feel Loved</button>
      <button class="secondary" onclick="go(3)">🌙 Hear Something Deep</button>
      <button class="secondary" onclick="go(3)">✨ Surprise Me</button>
    </div>
  </div>
</div>

<!-- SCENE 3 MESSAGE -->
<div class="scene" id="s3">
  <div>
    <h1>
      انا عارف اني اوقات كتير بزعلك و انك بتشوفي ده قلة اهتمام او زعلك ده حاجه بسيطه بالنسبالي ، ومقدرش الومك لو وصلك الاحساس ده<br><br>

      بس انا مقصدش ابدا احسسك كده و انتي فعلا اغلي انسانه ف حياتي ، مش حابب ابدا ازعلك تاني وانا مش شايف غيرك ولا عمري هشوف غيرك<br><br>

      ميفرقليش اي حد تاني وعشان كده بحاول اثبتلك ده ، انا نفسي علاقتنا تبقا اوضح من كده ونرجع زي زمان<br><br>

      انا بحبك و نفسي اوي اكمل حياتي معاكي
    </h1>

    <div class="buttons">
      <button class="primary" onclick="go(4)">YES 💖</button>
      <button class="secondary" onclick="go(5)">🥺 NO</button>
    </div>
  </div>
</div>

<!-- YES WORLD -->
<div class="scene" id="s4">
  <div>
    <h1>
      💖 She said yes…<br><br>
      From this moment, everything changes.
    </h1>

    <div class="buttons">
      <button class="primary" onclick="loop()">📖 Explore Our Future</button>
      <button class="secondary" onclick="restart()">🔁 Replay Journey</button>
    </div>
  </div>
</div>

<!-- NO WORLD -->
<div class="scene" id="s5">
  <div>
    <h1>
      💔 I understand…<br><br>
      I just hope you felt something real.
    </h1>

    <div class="buttons">
      <button class="primary" onclick="soft()">🌙 Calm Mode</button>
      <button class="secondary" onclick="restart()">🔁 Try Again</button>
    </div>
  </div>
</div>

<script>

function go(n){
  show(n);
}

function show(n){
  document.querySelectorAll('.scene').forEach(s => s.classList.remove('active'));
  document.getElementById('s'+n).classList.add('active');
}

function restart(){
  show(1);
}

function loop(){
  show(4);
  hearts(60);
}

function soft(){
  show(5);
}

function hearts(count){
  for(let i=0;i<count;i++){
    let h=document.createElement("div");
    h.innerHTML="💖";
    h.classList.add("heart");
    document.body.appendChild(h);

    h.style.left=Math.random()*100+"vw";
    h.style.top="80vh";
    h.style.fontSize=(10+Math.random()*20)+"px";

    setTimeout(()=>h.remove(),3000);
  }
}

</script>

</body>
</html>